# Server Configuration
PORT=5000
NODE_ENV=production

# (Optional) Google Gemini API Key for AI Features (Voice analysis, Catalogue auto-generation, AI Assistant)
# Rupkala includes intelligent built-in heuristic fallbacks if no API key is provided.
GEMINI_API_KEY=

# (Optional) If hosting the React frontend separately (e.g., on Vercel/Netlify),
# set this to the backend server URL (e.g., https://rupkala-backend.onrender.com)
VITE_API_BASE_URL=
